# syntax=docker/dockerfile:1.7
# =============================================================================
# Dockerfile.web: static web tier (nginx)
#
# Serves:
#   /           apps/web       marina dashboard SPA (SPA fallback to index.html)
#   /widgets/   apps/widgets   embeddable booking/lead widgets (ES modules)
#   /api/       reverse proxy to the API (API_UPSTREAM, default api:3001)
#
# Not included, on purpose (see docs/DEPLOYMENT.md, "What the web image serves"):
#   apps/admin   platform-admin console: deploy it separately on its own host,
#                not on tenant hostnames.
#   apps/portal  boater portal: still 100% mock data, not shippable yet.
#
# Build from the repo root:
#   docker build -f Dockerfile.web \
#     --build-arg VITE_CLERK_PUBLISHABLE_KEY=pk_live_... -t helm-web .
# VITE_* values are compiled into the JS bundle, so they must be public
# values (a Clerk *publishable* key is). Never pass secrets as build args.
# =============================================================================

ARG NODE_IMAGE=node:22-bookworm-slim
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine
ARG PNPM_VERSION=9.15.9

# -----------------------------------------------------------------------------
# base / fetch: same pattern as Dockerfile.api (lockfile-only fetch layer)
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    PUPPETEER_SKIP_DOWNLOAD=1
RUN npm install -g "pnpm@${PNPM_VERSION}" && pnpm --version
WORKDIR /repo

FROM base AS fetch
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

# -----------------------------------------------------------------------------
# build: offline install + Vite builds for web and widgets (and their deps)
# -----------------------------------------------------------------------------
FROM fetch AS build
ARG VITE_CLERK_PUBLISHABLE_KEY=""
ARG VITE_API_URL=""
ENV VITE_CLERK_PUBLISHABLE_KEY=${VITE_CLERK_PUBLISHABLE_KEY} \
    VITE_API_URL=${VITE_API_URL}
COPY . .
RUN pnpm install --offline --frozen-lockfile --filter "@helm/web..." --filter "@helm/widgets..."
# Type errors are gated in CI (`pnpm typecheck`). The image runs the bundle
# build only; workspace deps (shared-types, ui-kit) are built first
# (topological order).
RUN pnpm --filter "@helm/web..." --filter "@helm/widgets..." run build \
 && test -f apps/web/dist/index.html \
 && ls apps/widgets/dist/*.es.js

# -----------------------------------------------------------------------------
# runtime: unprivileged nginx (uid 101, port 8080)
# -----------------------------------------------------------------------------
FROM ${NGINX_IMAGE} AS runtime
USER root
RUN rm -f /etc/nginx/conf.d/default.conf
# Rendered by the image's entrypoint (envsubst) into /etc/nginx/conf.d/.
COPY nginx.conf /etc/nginx/templates/helm.conf.template
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
COPY --from=build /repo/apps/widgets/dist /usr/share/nginx/html/widgets
USER 101

ENV API_UPSTREAM=api:3001
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
