// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id                       String       @id @default(uuid())
  name                     String
  subdomain                String       @unique
  customDomain             String?
  brandingJson             Json?
  invoiceTemplateJson      Json?
  stripeAccountId          String?
  // DEPRECATED — SaaS subscriptions now live on Location. These are read-only
  // mirrors of the primary location's billing during the transition. Do not
  // write to or read from them in new code; use Location.* instead.
  stripeCustomerId         String?
  stripeSubscriptionId     String?
  // Per-tenant platform fee taken via Stripe Connect application_fee_amount.
  // Negotiated individually. Total fee = ceil(amount * pctBps / 10000) + fixedCents.
  applicationFeePctBps     Int          @default(0) // basis points (100 = 1%)
  applicationFeeFixedCents Int          @default(0)
  qboRealmId               String?
  qboAccessToken           String?
  qboRefreshToken          String?
  qboTokenExpiresAt        DateTime?
  qboConnectedAt           DateTime?
  // Last time we pulled Vendors / Bills from QBO for this tenant. Used as
  // the watermark when querying QBO for "everything updated since X".
  qboLastVendorPullAt      DateTime?
  qboLastBillPullAt        DateTime?
  timezone                 String       @default("America/New_York")
  fiscalYearEnd            String       @default("12/31")
  saasTierId               String?
  status                   TenantStatus @default(ACTIVE)
  gracePeriodStartedAt     DateTime?
  lockedAt                 DateTime?
  // Trial onboarding lifecycle. Set when status=TRIAL; cleared when the
  // tenant converts. trialEndsAt drives the days-remaining badge in the
  // admin Trials view.
  trialStartedAt           DateTime?
  trialEndsAt              DateTime?
  // Platform admin user (User row with role=PLATFORM_ADMIN) who owns
  // follow-up for this trial / at-risk tenant. Nullable — most tenants
  // are unassigned.
  assignedAdminUserId      String?
  // Operator opt-in: when true, autoRenewCheck() not only creates and
  // approves the renewal batch but also executes it immediately. Default
  // false because rate-change batches usually want a human glance.
  autoExecuteRenewals      Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  saasTier         SaasTier?         @relation(fields: [saasTierId], references: [id])
  users            User[]
  locations        Location[]
  saasInvoices     SaasInvoice[]
  supportTickets   SupportTicket[]
  portalMessages   PortalMessage[]
  customRoles      CustomRole[]
  scheduledReports ScheduledReport[]
  timelineEvents   TenantTimelineEvent[]

  @@map("tenants")
}

// Admin-side activity feed for a tenant. Powers the at-risk deep-dive
// "save play" log and the trial nudge / assignment audit trail. Distinct
// from AuditLog (which is tenant-scoped business event history) because
// these entries are written by platform_admin users about their
// retention work on the account.
model TenantTimelineEvent {
  id            String   @id @default(uuid())
  tenantId      String
  // adminUserId is the platform_admin who took the action. Nullable so
  // automated lifecycle entries (status transitions, etc.) can omit it.
  adminUserId   String?
  // type is a short machine-readable verb so the UI can pick an icon /
  // color: nudge_sent | assigned | unassigned | trial_extended |
  // coupon_applied | tier_changed | check_in_scheduled | ticket_opened |
  // note. Free-form on purpose — adding new save-play actions doesn't
  // require a migration.
  type          String
  summary       String
  // Optional structured payload for the action (e.g. new tier id, coupon
  // code, ticket id, scheduled-at timestamp). Rendered as small chips
  // below the summary in the timeline UI.
  metadataJson  Json?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("tenant_timeline_events")
}

// Deliverability suppression list. Separate from CommunicationPreference,
// which is a per-category opt-out for a known Customer. This table blocks
// an address from receiving ANY Helm email — populated by the Resend
// bounce/complaint webhook and by the unsubscribe link on outbound mail.
model EmailSuppression {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  reason    String // BOUNCED_HARD | COMPLAINED | UNSUBSCRIBED
  source    String // resend_bounce | resend_complaint | user_unsubscribe
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("email_suppressions")
}

model Location {
  id               String  @id @default(uuid())
  tenantId         String
  name             String
  address          String?
  city             String?
  state            String?
  zip              String?
  phone            String?
  timezone         String  @default("America/New_York")
  active           Boolean @default(true)
  transientEnabled Boolean @default(true)
  rentalsEnabled   Boolean @default(true)
  rampEnabled      Boolean @default(true)
  conciergeEnabled Boolean @default(true)

  // Per-location branding
  logoUrl      String?
  brandingJson Json?

  // Per-location QuickBooks connection (each property files its own books)
  qboRealmId          String?
  qboAccessToken      String?
  qboRefreshToken     String?
  qboTokenExpiresAt   DateTime?
  qboConnectedAt      DateTime?
  qboCompanyName      String?
  // Last time we pulled Vendors / Bills from QBO for this location.
  qboLastVendorPullAt DateTime?
  qboLastBillPullAt   DateTime?
  // Last time the chart of accounts was pulled from QBO for this location.
  qboLastChartOfAccountsSyncAt DateTime?

  // Per-location Stripe Connect (each property routes payments to its own account)
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)

  // Per-location renewal behavior
  autoExecuteRenewals Boolean @default(false)

  // ----- Per-location posting accounts -----
  // Pinned GL accounts used by gl-posting / qbo-sync when posting invoices,
  // payments, refunds, and deferred-revenue recognition for this location.
  // Falling back to tenant-wide account-number lookups would route ledger
  // entries (and QBO Invoice/Payment ARAccountRef + DepositToAccountRef) to
  // a different QBO realm — staff pin per-location accounts here so each
  // marina's books stay self-consistent.
  arGlAccountId               String?
  undepositedFundsGlAccountId String?
  deferredRevenueGlAccountId  String?

  arGlAccount               GlAccount? @relation(name: "LocationArGlAccount",               fields: [arGlAccountId],               references: [id])
  undepositedFundsGlAccount GlAccount? @relation(name: "LocationUndepositedFundsGlAccount", fields: [undepositedFundsGlAccountId], references: [id])
  deferredRevenueGlAccount  GlAccount? @relation(name: "LocationDeferredRevenueGlAccount",  fields: [deferredRevenueGlAccountId],  references: [id])

  // ----- Per-location SYSTEM posting accounts -----
  // Pinned chart-of-accounts rows for the four "system" postings that
  // gl-posting.ts used to fall back to hardcoded account numbers for
  // (4500 default revenue, 2400 sales tax payable, 4700 early-termination
  // income, 4600 ACH return fee). Falling back to a tenant-wide number
  // lookup silently mis-routed entries when (a) the per-location chart
  // didn't seed that number at all, or (b) the location was QBO-connected
  // but the matching number lived in a *different* realm's chart. Pinning
  // these per-location is the same contract as A/R / cash / deferred above:
  // QBO-connected locations REQUIRE the pin (the resolver throws
  // UNCONFIGURED_GL_MAPPING otherwise); non-QBO locations fall back to the
  // legacy account-number lookup so single-chart tenants keep working.
  defaultRevenueGlAccountId   String?
  salesTaxGlAccountId         String?
  earlyTerminationGlAccountId String?
  achReturnFeeGlAccountId     String?

  defaultRevenueGlAccount   GlAccount? @relation(name: "LocationDefaultRevenueGlAccount",   fields: [defaultRevenueGlAccountId],   references: [id])
  salesTaxGlAccount         GlAccount? @relation(name: "LocationSalesTaxGlAccount",         fields: [salesTaxGlAccountId],         references: [id])
  earlyTerminationGlAccount GlAccount? @relation(name: "LocationEarlyTerminationGlAccount", fields: [earlyTerminationGlAccountId], references: [id])
  achReturnFeeGlAccount     GlAccount? @relation(name: "LocationAchReturnFeeGlAccount",     fields: [achReturnFeeGlAccountId],     references: [id])

  // ----- Per-location SaaS subscription billing -----
  // We charge per marina (= per Location), not per holding company. Each
  // Location has its own Stripe Customer, Stripe Subscription and SaaS tier.
  // The matching fields on Tenant are deprecated mirrors kept only for legacy
  // reads during the transition; new writes/lookups must use these.
  saasTierId           String?
  stripeCustomerId     String? // Helm's platform customer record for this location's SaaS billing
  stripeSubscriptionId String? // active SaaS subscription on the platform account
  subscriptionStatus   String? // mirrors Stripe subscription.status (active, past_due, canceled, ...)
  gracePeriodStartedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  saasTier       SaasTier?       @relation(fields: [saasTierId], references: [id])
  dockageRates   DockageRate[]
  serviceFees    ServiceFee[]
  invoices       Invoice[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  userLocations  UserLocation[]
  glAccounts                 GlAccount[]                @relation(name: "LocationGlAccounts")
  productGlMappings          ProductGlMapping[]         @relation(name: "LocationProductGlMappings")
  productCategoryGlMappings  ProductCategoryGlMapping[] @relation(name: "LocationProductCategoryGlMappings")
  dockageRateGlMappings      DockageRateGlMapping[]     @relation(name: "LocationDockageRateGlMappings")
  serviceFeeGlMappings       ServiceFeeGlMapping[]      @relation(name: "LocationServiceFeeGlMappings")
  rentalProductGlMappings    RentalProductGlMapping[]   @relation(name: "LocationRentalProductGlMappings")

  @@index([tenantId])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("locations")
}

model SaasTier {
  id                  String  @id @default(uuid())
  name                String
  monthlyFeeCents     Int
  perLocationFeeCents Int
  achFeeRate          Float
  cardFeeRate         Float
  storageLimitGb      Int
  stripePriceId       String? // Stripe recurring Price used for SaaS subscription checkout

  tenants   Tenant[]
  locations Location[]

  @@map("saas_tiers")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  role         UserRole
  // Sub-role for users whose `role` is PLATFORM_ADMIN. Null for everyone
  // else. Defaults to READ_ONLY_SUPPORT for new platform admins so a
  // mis-provisioned admin can never accidentally cause damage.
  adminRole    AdminRole?
  firstName    String
  lastName     String
  clerkUserId  String?
  active       Boolean  @default(true)
  customRoleId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  customRole    CustomRole?    @relation(fields: [customRoleId], references: [id])
  userLocations UserLocation[]

  @@index([tenantId])
  @@map("users")
}

// Restricts which Locations a user may access. Users with bypass roles
// (PLATFORM_ADMIN, TENANT_ADMIN, MARINA_OWNER) ignore this table entirely
// and have full-tenant access. All other roles are denied access to any
// Location not in their UserLocation rows.
model UserLocation {
  userId     String
  locationId String
  tenantId   String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@index([tenantId])
  @@map("user_locations")
}

model CustomRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String   @default("#64748B")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@index([tenantId])
  @@map("custom_roles")
}

model RolePermission {
  id        String  @id @default(uuid())
  roleId    String
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@map("role_permissions")
}

