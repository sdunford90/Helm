generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  TRIAL
  ACTIVE
  GRACE_PERIOD
  LOCKED
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  MARINA_OWNER
  MARINA_MANAGER
  DOCK_STAFF
  POS_CASHIER
  ACCOUNTING
  PORTAL_USER
}

// Sub-role on PLATFORM_ADMIN users that controls what they can do in the
// admin console. Non-admin users have a NULL adminRole.
//   SUPERUSER          — full access; only role allowed to change other
//                        admins, request tenant exports, or delete tenants.
//   BILLING_ADMIN      — manage SaaS billing (tiers, invoices, refunds),
//                        impersonate, lock/unlock tenants. Cannot delete or
//                        export, cannot manage other admins.
//   READ_ONLY_SUPPORT  — read-only across the entire admin console; cannot
//                        perform any mutating action (no lock, no refunds,
//                        no impersonation, no role changes).
enum AdminRole {
  SUPERUSER
  BILLING_ADMIN
  READ_ONLY_SUPPORT
}

// Lifecycle of an asynchronous tenant data export request.
enum TenantExportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

// Lifecycle of a hard-delete request. PENDING entries become COMPLETED
// (cascade-deleted) once the 24h grace period elapses unless cancelled.
enum TenantDeletionStatus {
  PENDING
  CANCELLED
  COMPLETED
  FAILED
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadSource {
  WEBSITE
  REFERRAL
  WALK_IN
  PHONE
  SOCIAL_MEDIA
  EMAIL
  OTHER
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  HOLD
  ACCEPTED
  EXPIRED
  REMOVED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  WAITLIST
  COLLECTIONS_HOLD
  SEASONAL
}

enum SlipStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum ElectricityMode {
  FLAT_FEE
  METERED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  RENEWED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PAST_DUE
  VOID
  COLLECTIONS
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHARGE_TO_SLIP
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TerminationType {
  FIXED
  FORMULA
}

enum DeferredEntryStatus {
