  tenantId             String
  firstName            String
  lastName             String
  company              String?
  email                String?
  phone                String?
  addressJson          Json?
  dob                  DateTime?
  dlNumber             String?
  dlState              String?
  dlExpiry             DateTime?
  dlPhotoUrl           String?
  emergencyContactJson Json?
  status               CustomerStatus @default(ACTIVE)
  taxExempt            Boolean        @default(false)
