// Generic sync-ref table for QBO inventory postings that don't have a
// dedicated underlying Prisma record (e.g. inventory adjustments are still
// kept in-memory in apps/api/src/routes/inventory.ts). Keyed on
// (tenantId, sourceType, sourceId) so a single source row can hold one
// QBO reference per qboType.
model QboInventorySyncRef {
  id           String    @id @default(uuid())
  tenantId     String
  locationId   String?
  sourceType   String // 'product' | 'purchase_order' | 'inventory_adjustment' | 'vendor'
  sourceId     String
  qboType      String // 'Item' | 'Bill' | 'JournalEntry' | 'Vendor'
  qboId        String?
  lastSyncedAt DateTime?
  lastError    String?
  lastErrorAt  DateTime?
  retryCount   Int       @default(0)
  nextRetryAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, sourceType, sourceId])
  @@index([tenantId])
  @@index([tenantId, nextRetryAt])
  @@map("qbo_inventory_sync_refs")
}

// Persisted state for the "Retry all failed QBO inventory syncs" job. The
// retry walks every failed sync ref one at a time and waits on QuickBooks for
// each one, which can stretch into minutes. Persisting the snapshot here lets
// the polling endpoint survive an API restart and lets multiple replicas see
// consistent progress.
model QboInventoryResyncJob {
  id          String                        @id @default(uuid())
  tenantId    String
  status      String                        @default("running") // 'running' | 'succeeded' | 'failed'
  total       Int                           @default(0)
  processed   Int                           @default(0)
  attempted   Int                           @default(0)
  succeeded   Int                           @default(0)
  failed      Int                           @default(0)
  skipped     Int                           @default(0)
  startedAt   DateTime                      @default(now())
  updatedAt   DateTime                      @default(now()) @updatedAt
  completedAt DateTime?
  error       String?

  details QboInventoryResyncJobDetail[]

  @@index([tenantId])
  @@index([status, updatedAt])
  @@map("qbo_inventory_resync_jobs")
}

model QboInventoryResyncJobDetail {
  id         String   @id @default(uuid())
  jobId      String
  sequence   Int
  sourceType String
  sourceId   String
  qboType    String
  status     String   // 'succeeded' | 'failed' | 'skipped'
  error      String?
  createdAt  DateTime @default(now())

  job QboInventoryResyncJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, sequence])
  @@map("qbo_inventory_resync_job_details")
}

