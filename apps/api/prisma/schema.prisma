generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  GRACE_PERIOD
  LOCKED
}

enum UserRole {
  PLATFORM_ADMIN
  TENANT_ADMIN
  MARINA_OWNER
  MARINA_MANAGER
  DOCK_STAFF
  POS_CASHIER
  ACCOUNTING
  PORTAL_USER
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  HOLD
  ACCEPTED
  EXPIRED
  REMOVED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  WAITLIST
  COLLECTIONS_HOLD
  SEASONAL
}

enum SlipStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum ElectricityMode {
  FLAT_FEE
  METERED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  EXPIRING
  EXPIRED
  TERMINATED
  RENEWED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PAST_DUE
  VOID
  COLLECTIONS
}

enum PaymentMethod {
  CARD
  ACH
  CASH
  CHARGE_TO_SLIP
  GIFT_CARD
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TerminationType {
  FIXED
  FORMULA
}

enum DeferredEntryStatus {
  PENDING
  RECOGNIZED
}

enum DepositStatus {
  HELD
  RELEASED
  APPLIED
  REFUNDED
}

enum GLAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PricingRuleType {
  SEASONAL
  PEAK_DAY
  LEAD_TIME
  MULTI_DAY
}

enum SuggestionStatus {
  PENDING
  APPROVED
  IGNORED
}

enum AutomationEventType {
  ABANDONED_CART_1
  ABANDONED_CART_2
  ABANDONED_CART_3
  POST_BOOKING_CONFIRM
  PRE_ARRIVAL
  CHECK_IN_REMINDER
  POST_RENTAL_THANKS
  NPS_SURVEY
  GOOGLE_REVIEW_PROMPT
  RE_ENGAGEMENT
}

enum TransientStatus {
  BOOKED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  OVERSTAY
}

enum RampTicketType {
  SINGLE_LAUNCH
  DAILY_PASS
  SEASONAL_PASS
}

enum ConciergeStatus {
  SUBMITTED
  QUOTED
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  INVOICED
}

enum ShiftStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum DockWalkStatus {
  IN_PROGRESS
  COMPLETED
}

enum DockWalkItemStatus {
  OK
  VIOLATION
  NEEDS_ATTENTION
}

enum InsuranceStatus {
  PENDING_REVIEW
  APPROVED
  EXPIRED
  REJECTED
}

enum AnnouncementChannel {
  EMAIL
  SMS
  BOTH
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
  OPENED
}

enum ApiKeyScope {
  TENANT
  PORTFOLIO
}

enum CollectionResolution {
  PAID_IN_FULL
  SETTLED
  WRITTEN_OFF
}

enum ChargebackStatus {
  OPEN
  EVIDENCE_SUBMITTED
  WON
  LOST
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id                       String       @id @default(uuid())
  name                     String
  subdomain                String       @unique
  customDomain             String?
  brandingJson             Json?
  invoiceTemplateJson      Json?
  stripeAccountId          String?
  stripeCustomerId         String? // Helm's platform customer record for SaaS billing
  stripeSubscriptionId     String? // active SaaS subscription on the platform account
  // Per-tenant platform fee taken via Stripe Connect application_fee_amount.
  // Negotiated individually. Total fee = ceil(amount * pctBps / 10000) + fixedCents.
  applicationFeePctBps     Int          @default(0) // basis points (100 = 1%)
  applicationFeeFixedCents Int          @default(0)
  qboRealmId               String?
  qboAccessToken           String?
  qboRefreshToken          String?
  qboTokenExpiresAt        DateTime?
  qboConnectedAt           DateTime?
  // Last time we pulled Vendors / Bills from QBO for this tenant. Used as
  // the watermark when querying QBO for "everything updated since X".
  qboLastVendorPullAt      DateTime?
  qboLastBillPullAt        DateTime?
  timezone                 String       @default("America/New_York")
  fiscalYearEnd            String       @default("12/31")
  saasTierId               String?
  status                   TenantStatus @default(ACTIVE)
  gracePeriodStartedAt     DateTime?
  lockedAt                 DateTime?
  // Operator opt-in: when true, autoRenewCheck() not only creates and
  // approves the renewal batch but also executes it immediately. Default
  // false because rate-change batches usually want a human glance.
  autoExecuteRenewals      Boolean      @default(false)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  saasTier         SaasTier?         @relation(fields: [saasTierId], references: [id])
  users            User[]
  locations        Location[]
  saasInvoices     SaasInvoice[]
  supportTickets   SupportTicket[]
  portalMessages   PortalMessage[]
  customRoles      CustomRole[]
  scheduledReports ScheduledReport[]

  @@map("tenants")
}

// Deliverability suppression list. Separate from CommunicationPreference,
// which is a per-category opt-out for a known Customer. This table blocks
// an address from receiving ANY Helm email — populated by the Resend
// bounce/complaint webhook and by the unsubscribe link on outbound mail.
model EmailSuppression {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  reason    String // BOUNCED_HARD | COMPLAINED | UNSUBSCRIBED
  source    String // resend_bounce | resend_complaint | user_unsubscribe
  createdAt DateTime @default(now())

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("email_suppressions")
}

model Location {
  id               String  @id @default(uuid())
  tenantId         String
  name             String
  address          String?
  city             String?
  state            String?
  zip              String?
  phone            String?
  timezone         String  @default("America/New_York")
  active           Boolean @default(true)
  transientEnabled Boolean @default(true)
  rentalsEnabled   Boolean @default(true)

  // Per-location branding
  logoUrl      String?
  brandingJson Json?

  // Per-location QuickBooks connection (each property files its own books)
  qboRealmId          String?
  qboAccessToken      String?
  qboRefreshToken     String?
  qboTokenExpiresAt   DateTime?
  qboConnectedAt      DateTime?
  qboCompanyName      String?
  // Last time we pulled Vendors / Bills from QBO for this location.
  qboLastVendorPullAt DateTime?
  qboLastBillPullAt   DateTime?

  // Per-location Stripe Connect (each property routes payments to its own account)
  stripeAccountId          String?
  stripeOnboardingComplete Boolean @default(false)

  // Per-location renewal behavior
  autoExecuteRenewals Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  dockageRates   DockageRate[]
  serviceFees    ServiceFee[]
  invoices       Invoice[]
  products       Product[]
  purchaseOrders PurchaseOrder[]
  userLocations  UserLocation[]

  @@index([tenantId])
  @@map("locations")
}

model SaasTier {
  id                  String  @id @default(uuid())
  name                String
  monthlyFeeCents     Int
  perLocationFeeCents Int
  achFeeRate          Float
  cardFeeRate         Float
  storageLimitGb      Int
  stripePriceId       String? // Stripe recurring Price used for SaaS subscription checkout

  tenants Tenant[]

  @@map("saas_tiers")
}

model User {
  id           String   @id @default(uuid())
  tenantId     String
  email        String
  role         UserRole
  firstName    String
  lastName     String
  clerkUserId  String?
  active       Boolean  @default(true)
  customRoleId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  customRole    CustomRole?    @relation(fields: [customRoleId], references: [id])
  userLocations UserLocation[]

  @@index([tenantId])
  @@map("users")
}

// Restricts which Locations a user may access. Users with bypass roles
// (PLATFORM_ADMIN, TENANT_ADMIN, MARINA_OWNER) ignore this table entirely
// and have full-tenant access. All other roles are denied access to any
// Location not in their UserLocation rows.
model UserLocation {
  userId     String
  locationId String
  tenantId   String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([userId, locationId])
  @@index([userId])
  @@index([locationId])
  @@index([tenantId])
  @@map("user_locations")
}

model CustomRole {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  color       String   @default("#64748B")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  users       User[]

  @@index([tenantId])
  @@map("custom_roles")
}

model RolePermission {
  id        String  @id @default(uuid())
  roleId    String
  module    String
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role CustomRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@map("role_permissions")
}

model LeadForm {
  id         String  @id @default(uuid())
  tenantId   String
  locationId String?
  formType   String
  name       String
  fieldsJson Json
  active     Boolean @default(true)
  embedKey   String  @unique @default(uuid())

  leads Lead[]

  @@index([tenantId])
  @@map("lead_forms")
}

model Lead {
  id           String    @id @default(uuid())
  tenantId     String
  locationId   String?
  stage        LeadStage @default(NEW)
  sourceFormId String?
  sourceUrl    String?
  utmSource    String?
  utmMedium    String?
  referralCode String?
  firstName    String
  lastName     String
  email        String?
  phone        String?
  boatLength   Float?
  slipType     String?
  notes        String?
  assignedTo   String?
  lostReason   String?
  convertedAt  DateTime?
  customerId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sourceForm      LeadForm?       @relation(fields: [sourceFormId], references: [id])
  waitlistEntries WaitlistEntry[]

  @@index([tenantId])
  @@map("leads")
}

model ReferralPartner {
  id               String  @id @default(uuid())
  tenantId         String
  name             String
  code             String  @unique
  contactEmail     String?
  type             String
  leadsCount       Int     @default(0)
  conversionsCount Int     @default(0)

  @@index([tenantId])
  @@map("referral_partners")
}

model WaitlistEntry {
  id            String         @id @default(uuid())
  tenantId      String
  locationId    String?
  customerId    String?
  leadId        String?
  slipType      String?
  boatLength    Float?
  desiredDate   DateTime?
  queuePosition Int
  status        WaitlistStatus @default(WAITING)
  notifiedAt    DateTime?
  holdExpiresAt DateTime?
  createdAt     DateTime       @default(now())

  customer Customer? @relation(fields: [customerId], references: [id])
  lead     Lead?     @relation(fields: [leadId], references: [id])

  @@index([tenantId])
  @@map("waitlist_entries")
}

model Customer {
  id                   String         @id @default(uuid())
  tenantId             String
  firstName            String
  lastName             String
  company              String?
  email                String?
  phone                String?
  addressJson          Json?
  dob                  DateTime?
  dlNumber             String?
  dlState              String?
  dlExpiry             DateTime?
  dlPhotoUrl           String?
  emergencyContactJson Json?
  status               CustomerStatus @default(ACTIVE)
  taxExempt            Boolean        @default(false)
  exemptionCertUrl     String?
  exemptionExpiry      DateTime?
  achBlocked           Boolean        @default(false)
  stripeCustomerId     String?
  qboCustomerId        String?
  leadSource           String?
  convertedFromLeadId  String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  boats                    Boat[]
  waitlistEntries          WaitlistEntry[]
  slipContracts            SlipContract[]
  invoices                 Invoice[]
  payments                 Payment[]
  reservations             Reservation[]
  conciergeRequests        ConciergeRequest[]
  securityDeposits         SecurityDeposit[]
  insuranceRecords         InsuranceRecord[]
  announcementDeliveries   AnnouncementDelivery[]
  achReturns               AchReturn[]
  chargebacks              Chargeback[]
  collectionsAccounts      CollectionsAccount[]
  npsSurveys               NpsSurvey[]
  transientBookings        TransientBooking[]
  rampTickets              RampTicket[]
  communicationPreferences CommunicationPreference[]
  portalMessages           PortalMessage[]
  documents                CustomerDocument[]

  @@index([tenantId])
  @@map("customers")
}

model CustomerDocument {
  id           String   @id @default(uuid())
  tenantId     String
  customerId   String
  category     String
  filename     String
  contentType  String
  sizeBytes    Int
  storageKey   String
  uploadedById String?
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_documents")
}

model Boat {
  id                 String    @id @default(uuid())
  tenantId           String
  customerId         String
  name               String?
  registrationNumber String?
  registrationState  String?
  registrationExpiry DateTime?
  hin                String?
  make               String?
  model              String?
  year               Int?
  lengthFt           Float
  beamFt             Float?
  draftFt            Float?
  fuelType           String?
  engineCount        Int?
  engineHp           Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  customer         Customer             @relation(fields: [customerId], references: [id])
  safetyRecords    VesselSafetyRecord[]
  insuranceRecords InsuranceRecord[]
  slipContracts    SlipContract[]

  @@index([tenantId])
  @@map("boats")
}

model VesselSafetyRecord {
  id              String    @id @default(uuid())
  tenantId        String
  boatId          String
  inspectionDate  DateTime
  inspectorId     String?
  passFail        String?
  notes           String?
  fireExtCount    Int?
  fireExtExpiry   DateTime?
  lifeJacketCount Int?
  flareExpiry     DateTime?
  hasHorn         Boolean?
  hasThrowable    Boolean?
  nextDueDate     DateTime?

  boat Boat @relation(fields: [boatId], references: [id])

  @@index([tenantId])
  @@map("vessel_safety_records")
}

model Slip {
  id               String          @id @default(uuid())
  tenantId         String
  dockId           String?
  locationId       String?
  slipNumber       String
  lengthFt         Float
  beamFt           Float?
  depthFt          Float?
  slipType         String?
  shorePower       String?
  status           SlipStatus      @default(VACANT)
  transientCapable Boolean         @default(false)
  electricityMode  ElectricityMode @default(FLAT_FEE)
  flatFeeCents     Int?
  kwhRateCents     Int?
  qrCodeUrl        String?

  contracts         SlipContract[]
  meterReadings     MeterReading[]
  transientBookings TransientBooking[]
  dockWalkItems     DockWalkItem[]
  pumpOuts          PumpOut[]

  @@index([tenantId])
  @@map("slips")
}

model SlipContract {
  id                    String           @id @default(uuid())
  tenantId              String
  slipId                String
  customerId            String
  boatId                String?
  startDate             DateTime
  endDate               DateTime?
  billingCycle          BillingCycle     @default(MONTHLY)
  billingAnchor         Int?
  rateCents             Int
  electricityMode       ElectricityMode?
  autoRenew             Boolean          @default(false)
  status                ContractStatus   @default(DRAFT)
  securityDepositCents  Int?
  earlyTerminationType  TerminationType?
  earlyTerminationValue Float?
  qboItemId             String?
  renewalBatchId        String?
  esignEnvelopeId       String?
  signedAt              DateTime?
  signedDocumentUrl     String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  slip             Slip              @relation(fields: [slipId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  boat             Boat?             @relation(fields: [boatId], references: [id])
  renewalBatch     RenewalBatch?     @relation(fields: [renewalBatchId], references: [id])
  securityDeposits SecurityDeposit[]

  @@index([tenantId])
  @@map("slip_contracts")
}

model RenewalBatch {
  id                String    @id @default(uuid())
  tenantId          String
  createdBy         String
  status            String
  rateIncreaseType  String?
  rateIncreaseValue Float?
  contractCount     Int
  revenueDeltaCents Int?
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime  @default(now())

  contracts SlipContract[]

  @@index([tenantId])
  @@map("renewal_batches")
}

model MeterReading {
  id          String   @id @default(uuid())
  tenantId    String
  slipId      String
  readingDate DateTime
  previousKwh Float
  currentKwh  Float
  consumedKwh Float
  rateCents   Int
  amountCents Int
  isEstimated Boolean  @default(false)
  staffId     String?

  slip Slip @relation(fields: [slipId], references: [id])

  @@index([tenantId])
  @@map("meter_readings")
}

model Invoice {
  id            String        @id @default(uuid())
  tenantId      String
  customerId    String
  locationId    String?
  invoiceNumber String
  issuedDate    DateTime
  dueDate       DateTime
  status        InvoiceStatus @default(DRAFT)
  subtotalCents Int
  taxCents      Int           @default(0)
  totalCents    Int
  balanceCents  Int
  pdfUrl        String?
  qboInvoiceId  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer          @relation(fields: [customerId], references: [id])
  location  Location?         @relation(fields: [locationId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@index([tenantId])
  @@index([locationId])
  @@map("invoices")
}

model InvoiceLineItem {
  id             String  @id @default(uuid())
  invoiceId      String
  description    String
  quantity       Float   @default(1)
  unitPriceCents Int
  discountCents  Int     @default(0)
  taxRate        Float   @default(0)
  taxCents       Int     @default(0)
  extendedCents  Int
  glAccountId    String?
  isDeferred     Boolean @default(false)
  sourceType     String?
  sourceId       String?

  invoice           Invoice              @relation(fields: [invoiceId], references: [id])
  glAccount         GlAccount?           @relation(fields: [glAccountId], references: [id])
  deferredSchedules DeferredSchedule[]
  taxBreakdowns     InvoiceLineItemTax[]

  @@map("invoice_line_items")
}

model Payment {
  id              String        @id @default(uuid())
  tenantId        String
  customerId      String
  invoiceId       String?
  amountCents     Int
  method          PaymentMethod
  stripePaymentId String?
  postedDate      DateTime
  status          PaymentStatus @default(PENDING)
  qboPaymentId    String?
  createdAt       DateTime      @default(now())

  customer   Customer    @relation(fields: [customerId], references: [id])
  invoice    Invoice?    @relation(fields: [invoiceId], references: [id])
  achReturns AchReturn[]

  @@index([tenantId])
  @@map("payments")
}

model ProcessedWebhook {
  id            String   @id @default(uuid())
  stripeEventId String   @unique
  processedAt   DateTime @default(now())
  status        String
  tenantId      String?

  @@map("processed_webhooks")
}

// Persisted log of every accepted Intuit QuickBooks Online webhook delivery.
// We respond 200 to Intuit immediately and process entities in the background,
// which loses Intuit's built-in retry behavior on transient failures. Saving
// the raw payload + signature with a status lets operators review failures
// and trigger a replay from an admin endpoint or script.
//
// status: "PENDING" while the background dispatcher is running, then
//   "PROCESSED" or "FAILED" depending on the outcome. lastError captures
//   the most recent failure message for FAILED rows.
//
// tenantId / locationId are populated when the realmId resolves to a known
// Helm tenant/location; they remain null for deliveries we cannot route
// (still saved so an operator can investigate).
model QboWebhookDelivery {
  id          String    @id @default(uuid())
  realmId     String
  tenantId    String?
  locationId  String?
  signature   String
  payloadJson Json
  status      String    @default("PENDING")
  attempts    Int       @default(0)
  lastError   String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([status, receivedAt])
  @@index([tenantId, status])
  @@index([realmId])
  @@map("qbo_webhook_deliveries")
}

model AchReturn {
  id                 String    @id @default(uuid())
  tenantId           String
  paymentId          String
  customerId         String
  rCode              String
  returnedAt         DateTime
  reversalEntryId    String?
  returnFeeCents     Int?
  customerNotifiedAt DateTime?
  achBlockedSet      Boolean   @default(false)

  payment  Payment  @relation(fields: [paymentId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@map("ach_returns")
}

model Chargeback {
  id                  String           @id @default(uuid())
  tenantId            String
  customerId          String
  stripeDisputeId     String           @unique
  amountCents         Int
  status              ChargebackStatus @default(OPEN)
  evidenceSubmittedAt DateTime?
  outcome             String?
  creditIssuedCents   Int?
  platformFeeCents    Int?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@map("chargebacks")
}

model CollectionsAccount {
  id                    String                @id @default(uuid())
  tenantId              String
  customerId            String
  assignedAt            DateTime              @default(now())
  assignedBy            String
  agencyName            String?
  balanceAtHandoffCents Int
  status                String
  recoveredCents        Int                   @default(0)
  resolvedAt            DateTime?
  resolutionType        CollectionResolution?

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId])
  @@map("collections_accounts")
}

model DeferredSchedule {
  id                String   @id @default(uuid())
  tenantId          String
  invoiceLineItemId String
  totalCents        Int
  recognizedCents   Int      @default(0)
  startDate         DateTime
  endDate           DateTime
  status            String

  invoiceLineItem InvoiceLineItem @relation(fields: [invoiceLineItemId], references: [id])
  entries         DeferredEntry[]

  @@index([tenantId])
  @@map("deferred_schedules")
}

model DeferredEntry {
  id              String              @id @default(uuid())
  scheduleId      String
  recognitionDate DateTime
  amountCents     Int
  glEntryId       String?
  status          DeferredEntryStatus @default(PENDING)

  schedule DeferredSchedule @relation(fields: [scheduleId], references: [id])

  @@map("deferred_entries")
}

model SecurityDeposit {
  id                  String        @id @default(uuid())
  tenantId            String
  customerId          String
  contractId          String?
  amountCents         Int
  stripeChargeId      String?
  status              DepositStatus @default(HELD)
  releasedAt          DateTime?
  appliedToInvoiceId  String?
  qboLiabilityEntryId String?

  customer Customer      @relation(fields: [customerId], references: [id])
  contract SlipContract? @relation(fields: [contractId], references: [id])

  @@index([tenantId])
  @@map("security_deposits")
}

model GlAccount {
  id                String        @id @default(uuid())
  tenantId          String
  accountNumber     String
  name              String
  type              GLAccountType
  subType           String?
