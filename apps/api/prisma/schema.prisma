// ---------------------------------------------------------------------------
// Per-location GL mapping tables — overlay the tenant-level FKs on
// Product/ProductCategory/DockageRate/ServiceFee so operators can map each
// item to the right account in each location's QBO chart of accounts. The
// tenant-level FK on the source row is preserved as a legacy fallback so
// nothing breaks during the rollout.
// ---------------------------------------------------------------------------

model ProductGlMapping {
  id                        String   @id @default(uuid())
  tenantId                  String
  productId                 String
  locationId                String
  revenueGlAccountId        String?
  cogsGlAccountId           String?
  inventoryAssetGlAccountId String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @default(now()) @updatedAt

  product                 Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  location                Location   @relation(name: "LocationProductGlMappings", fields: [locationId], references: [id], onDelete: Cascade)
  revenueGlAccount        GlAccount? @relation(name: "ProductGlMappingRevenue", fields: [revenueGlAccountId], references: [id])
  cogsGlAccount           GlAccount? @relation(name: "ProductGlMappingCogs", fields: [cogsGlAccountId], references: [id])
  inventoryAssetGlAccount GlAccount? @relation(name: "ProductGlMappingInventoryAsset", fields: [inventoryAssetGlAccountId], references: [id])

  @@unique([productId, locationId])
  @@index([tenantId])
  @@index([locationId])
  @@map("product_gl_mappings")
}

