  cogsGlAccount           GlAccount?      @relation(name: "ProductCategoryGlMappingCogs", fields: [cogsGlAccountId], references: [id])
  inventoryAssetGlAccount GlAccount?      @relation(name: "ProductCategoryGlMappingInventoryAsset", fields: [inventoryAssetGlAccountId], references: [id])

