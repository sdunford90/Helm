  ratePctBps     Int
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  glAccountId    String?

  jurisdiction TaxJurisdiction @relation(fields: [jurisdictionId], references: [id])

  @@index([tenantId])
  @@index([jurisdictionId, effectiveFrom])
  @@map("tax_rates")
}

model LocationTaxJurisdiction {
  id             String @id @default(uuid())
  tenantId       String
  locationId     String
  jurisdictionId String
  sortOrder      Int    @default(0)

  jurisdiction TaxJurisdiction @relation(fields: [jurisdictionId], references: [id])

  @@unique([locationId, jurisdictionId])
  @@map("location_tax_jurisdictions")
}

model InvoiceLineItemTax {
  id             String @id @default(uuid())
  tenantId       String
  lineItemId     String
  jurisdictionId String
  ratePctBps     Int
  taxableCents   Int
  taxCents       Int

  lineItem     InvoiceLineItem @relation(fields: [lineItemId], references: [id])
  jurisdiction TaxJurisdiction @relation(fields: [jurisdictionId], references: [id])

  @@index([tenantId])
  @@index([jurisdictionId])
  @@index([lineItemId])
  @@map("invoice_line_item_tax")
}

// ==========================================================================
//  CATALOG — DOCKAGE RATES
// ==========================================================================

model DockageRate {
  id                   String          @id @default(uuid())
  tenantId             String
  locationId           String
  slipType             String
  monthlyRateCents     Int
  quarterlyRateCents   Int?
  annualRateCents      Int?
  electricityMode      ElectricityMode @default(METERED)
  electricityRateCents Int?
  glAccountId          String?
  taxClass             String?         @default("Standard")
  active               Boolean         @default(true)
  effectiveFrom        DateTime?
  effectiveTo          DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  location Location @relation(fields: [locationId], references: [id])

  @@index([tenantId])
  @@index([locationId])
  @@map("dockage_rates")
}

// ==========================================================================
//  CATALOG — SERVICE FEES
// ==========================================================================

enum FeeType {
  FLAT
  PERCENT
}

model ServiceFee {
  id          String   @id @default(uuid())
  tenantId    String
  locationId  String
  name        String
  feeType     FeeType  @default(FLAT)
  amountCents Int?
  pct         Float?
  glAccountId String?
  taxClass    String?  @default("Tax Exempt")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  location Location @relation(fields: [locationId], references: [id])

  @@index([tenantId])
  @@index([locationId])
  @@map("service_fees")
}

// ==========================================================================
//  PLATFORM (SAAS) BILLING
// ==========================================================================

model SaasInvoice {
  id          String    @id @default(uuid())
  tenantId    String
  periodStart DateTime
  periodEnd   DateTime
  amountCents Int
  status      String    @default("issued") // draft | issued | paid | past_due
  issuedAt    DateTime  @default(now())
  paidAt      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("saas_invoices")
}

// ==========================================================================
//  PORTAL MESSAGES
// ==========================================================================

model PortalMessage {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  sender     String // "customer" | "staff"
  staffName  String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("portal_messages")
}

// ==========================================================================
//  SUPPORT TICKETS
// ==========================================================================

model SupportTicket {
  id          String   @id @default(uuid())
  tenantId    String
  subject     String
  description String
  status      String   @default("open") // open | in_progress | waiting_on_customer | resolved | closed
  priority    String   @default("medium") // low | medium | high | urgent
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("support_tickets")
}

// ==========================================================================
//  FUEL
// ==========================================================================

model FuelSale {
  id                  String   @id @default(uuid())
  tenantId            String
  customerId          String?
  guestName           String?
  fuelType            String
  gallons             Float
  priceCentsPerGallon Int
  totalCents          Int
  pumpNumber          Int?
  staffId             String?
  paymentMethod       String?
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@map("fuel_sales")
}

model FuelDelivery {
  id                    String   @id @default(uuid())
  tenantId              String
  supplier              String
  fuelType              String
  gallons               Float
  costCentsPerGallon    Int
  totalCostCents        Int
  tankLevelAfterGallons Float?
  notes                 String?
  deliveredAt           DateTime @default(now())

  @@index([tenantId])
  @@map("fuel_deliveries")
}

// ==========================================================================
//  SCHEDULED REPORTS
// ==========================================================================

model ScheduledReport {
  id         String    @id @default(uuid())
  tenantId   String
  reportId   String
  reportName String
  frequency  String // "Daily" | "Weekly" | "Monthly"
  format     String    @default("CSV") // "CSV" | "JSON" (scheduled delivery only)
  recipients String // comma-separated email addresses
  status     String    @default("Active") // "Active" | "Paused"
  nextRun    DateTime
  lastRun    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("scheduled_reports")
}
