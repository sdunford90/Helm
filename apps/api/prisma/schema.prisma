  inventoryAssetGlAccount GlAccount?            @relation(name: "ProductInventoryAssetGlAccount", fields: [inventoryAssetGlAccountId], references: [id])
  revenueGlAccount        GlAccount?            @relation(name: "ProductRevenueGlAccount", fields: [revenueGlAccountId], references: [id])
  productCategory         ProductCategory?      @relation(fields: [productCategoryId], references: [id])
