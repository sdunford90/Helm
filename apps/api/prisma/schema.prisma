// ==========================================================================

model SaasInvoice {
  id                 String    @id @default(uuid())
  tenantId           String
  periodStart        DateTime
  periodEnd          DateTime
  amountCents        Int // gross monthly fee before discount; final = amountCents + prorationCents - discountCents - refundedCents
  discountCents      Int       @default(0) // total coupon discount applied
  refundedCents      Int       @default(0) // total refund(s) applied
  prorationCents     Int       @default(0) // net plan-change proration baked into this invoice
  status             String    @default("issued") // draft | issued | paid | past_due | written_off
  issuedAt           DateTime  @default(now())
  dueDate            DateTime?
  paidAt             DateTime?
  // Per-invoice dunning state
  failedAttempts     Int       @default(0)
  lastAttemptAt      DateTime?
  nextRetryAt        DateTime?
  dunningPaused      Boolean   @default(false) // when true, lifecycle job will not auto-lock
  pausedUntil        DateTime?
  writeOffAt         DateTime?
  writeOffReason     String?
  // Optional pointers
  couponRedemptionId String?
  planChangeId       String? // marks proration adjustment lines

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  refunds  SaasInvoiceRefund[]

  @@index([tenantId])
  @@index([status])
  @@map("saas_invoices")
}

// ── Coupons & redemptions ─────────────────────────────────────────────────────

enum SaasCouponDiscountType {
  PERCENT // discountValue is basis points (1000 = 10%)
  FIXED // discountValue is cents off the monthly fee
  TRIAL_EXTENSION // discountValue is days of trial extension
}

enum SaasCouponDuration {
  ONCE // applied to one billing cycle
  REPEATING // applied to N billing cycles (durationCycles)
}

model SaasCoupon {
  id             String                 @id @default(uuid())
  code           String                 @unique
  name           String
  discountType   SaasCouponDiscountType
  discountValue  Int
  duration       SaasCouponDuration     @default(ONCE)
  durationCycles Int? // required when duration = REPEATING
  maxRedemptions Int? // null = unlimited
  active         Boolean                @default(true)
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  redemptions SaasCouponRedemption[]

  @@map("saas_coupons")
}

model SaasCouponRedemption {
  id                   String    @id @default(uuid())
  couponId             String
  tenantId             String
  active               Boolean   @default(true)
  cyclesRemaining      Int? // counts down each cycle for REPEATING; null for ONCE/TRIAL_EXTENSION
  redeemedAt           DateTime  @default(now())
  lastAppliedAt        DateTime?
  lastAppliedInvoiceId String?

  coupon SaasCoupon @relation(fields: [couponId], references: [id])

  @@unique([couponId, tenantId])
  @@index([tenantId])
  @@map("saas_coupon_redemptions")
}

model SaasInvoiceRefund {
  id            String   @id @default(uuid())
  saasInvoiceId String
  amountCents   Int
  reason        String // dropdown value (DUPLICATE_CHARGE | SERVICE_OUTAGE | GOODWILL | BILLING_ERROR | CANCELLATION | OTHER)
  notes         String?
  createdBy     String?
  createdAt     DateTime @default(now())

  saasInvoice SaasInvoice @relation(fields: [saasInvoiceId], references: [id])

  @@index([saasInvoiceId])
  @@map("saas_invoice_refunds")
}

model SaasPlanChange {
  id                 String   @id @default(uuid())
  tenantId           String
  fromTierId         String?
  toTierId           String
  prorationCents     Int // signed: positive = charge, negative = credit
  effectiveAt        DateTime @default(now())
  appliedToInvoiceId String? // SaasInvoice that includes the proration line
  createdBy          String?
  createdAt          DateTime @default(now())

  @@index([tenantId])
  @@map("saas_plan_changes")
}

// ==========================================================================
//  PORTAL MESSAGES
// ==========================================================================

model PortalMessage {
  id         String   @id @default(uuid())
  tenantId   String
  customerId String
  sender     String // "customer" | "staff"
  staffName  String?
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([tenantId, customerId])
  @@map("portal_messages")
}

// ==========================================================================
//  SUPPORT TICKETS
// ==========================================================================

model SupportTicket {
  id          String   @id @default(uuid())
  tenantId    String
  subject     String
  description String
  status      String   @default("open") // open | in_progress | waiting_on_customer | resolved | closed
  priority    String   @default("medium") // low | medium | high | urgent
  assignedTo  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("support_tickets")
}

// ==========================================================================
//  FUEL
// ==========================================================================

model FuelSale {
  id                  String   @id @default(uuid())
  tenantId            String
  customerId          String?
  guestName           String?
  fuelType            String
  gallons             Float
  priceCentsPerGallon Int
  totalCents          Int
  pumpNumber          Int?
  staffId             String?
  paymentMethod       String?
  createdAt           DateTime @default(now())

  @@index([tenantId])
  @@map("fuel_sales")
}

model FuelDelivery {
  id                    String   @id @default(uuid())
  tenantId              String
  supplier              String
  fuelType              String
  gallons               Float
  costCentsPerGallon    Int
  totalCostCents        Int
  tankLevelAfterGallons Float?
  notes                 String?
  deliveredAt           DateTime @default(now())

  @@index([tenantId])
  @@map("fuel_deliveries")
}

// ==========================================================================
//  SCHEDULED REPORTS
// ==========================================================================

model ScheduledReport {
  id         String    @id @default(uuid())
  tenantId   String
  reportId   String
  reportName String
  frequency  String // "Daily" | "Weekly" | "Monthly"
  format     String    @default("CSV") // "CSV" | "JSON" (scheduled delivery only)
  recipients String // comma-separated email addresses
  status     String    @default("Active") // "Active" | "Paused"
  nextRun    DateTime
  lastRun    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("scheduled_reports")
}

// ==========================================================================
//  ADMIN GOVERNANCE & COMPLIANCE
// ==========================================================================

// Records every action a platform admin performs in the admin console.
// Separate from the per-tenant AuditLog so admin activity is queryable
// without bleeding into operator-facing audit trails. The `targetTenantId`
// is the tenant the action affected, when applicable. Some actions
// (e.g. ROLE_CHANGE on another admin) have no target tenant.
model AdminAuditLog {
  id             String    @id @default(uuid())
  actorUserId    String
  actorEmail     String
  actorName      String?
  actorAdminRole String? // snapshot at the time of the action
  action         String // TENANT_LOCK | TENANT_UNLOCK | TENANT_TIER_CHANGE | TENANT_IMPERSONATE_START | ...
  targetTenantId String?
  targetType     String? // optional secondary target (USER, SAAS_INVOICE, etc.)
  targetId       String?
  detailsJson    Json?
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([targetTenantId])
  @@index([action])
  @@map("admin_audit_logs")
}

// Async tenant data export request. The job worker walks the tenant's
// rows table-by-table, writes CSVs to a ZIP archive, and either uploads
// to R2 (when configured) or stores the buffer in `localBlob` so it can
// be streamed back via the download endpoint.
model TenantExport {
  id              String             @id @default(uuid())
  tenantId        String
  requestedById   String
  requestedByEmail String
  status          TenantExportStatus @default(PENDING)
  storageKey      String? // R2 object key when uploaded externally
  downloadToken   String             @unique @default(uuid())
  fileSizeBytes   Int?
  rowCounts       Json? // per-table row counts captured during export
  errorMsg        String?
  startedAt       DateTime?
  completedAt     DateTime?
  expiresAt       DateTime? // download link expiration (typically +7 days)
  createdAt       DateTime           @default(now())

  // Local fallback storage when R2 is not configured. Stored as Bytes
  // so the API can stream it directly to the requester. Cleared after
  // expiresAt by a periodic job.
  localBlob       Bytes?

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
  @@map("tenant_exports")
}

// Pending hard-delete request. Stays PENDING for 24 hours so a Superuser
// can cancel before the cascade fires. The tenant lifecycle job promotes
// PENDING -> COMPLETED (and runs the cascade) when scheduledFor <= now.
model TenantDeletion {
  id                String               @id @default(uuid())
  tenantId          String               @unique
  requestedById     String
  requestedByEmail  String
  scheduledFor      DateTime // requestedAt + 24h
  status            TenantDeletionStatus @default(PENDING)
  cancelledAt       DateTime?
  cancelledById     String?
  completedAt       DateTime?
  errorMsg          String?
  createdAt         DateTime             @default(now())

  @@index([status, scheduledFor])
  @@index([tenantId])
  @@map("tenant_deletions")
}

// ==========================================================================
//  PLATFORM SETTINGS
//
// Single-row table holding platform-wide tunables surfaced by the admin
// Platform Settings page. Always identified by the literal id 'singleton'
// so reads + writes don't need to pick a row. Only PLATFORM_ADMIN may
// read or write it.
// ==========================================================================

model PlatformSetting {
  id                  String   @id @default("singleton")
  defaultTier         String?
  trialDurationDays   Int      @default(14)
  gracePeriodDays     Int      @default(7)
  autoLockAfterGrace  Boolean  @default(true)
  achFeeRatePct       Float    @default(0.8)
  cardFeeRatePct      Float    @default(2.9)
  stripeConnectFeePct Float    @default(0.5)
  feeCapCents         Int      @default(5000)
  maintenanceMode     Boolean  @default(false)
  maintenanceMessage  String   @default("We're performing scheduled maintenance. We'll be back shortly. Thank you for your patience.")
  featureFlagsJson    Json     @default("{}")
  updatedAt           DateTime @updatedAt
  updatedBy           String?

  @@map("platform_settings")
}
