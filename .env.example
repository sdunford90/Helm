# ----------------------------------------------------------------------------
# REQUIRED when NODE_ENV=production: DATABASE_URL, CLERK_SECRET_KEY,
# CLERK_PUBLISHABLE_KEY. The API refuses to boot without them
# (apps/api/src/lib/env.ts). Everything else is optional.
# ----------------------------------------------------------------------------

# Database
DATABASE_URL="postgresql://user:password@host:5432/helm?schema=public"
NEON_API_KEY=""

# Clerk Auth
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_WEBHOOK_SECRET=""
# Optional comma-separated allow-list of origins for Clerk's azp claim
CLERK_AUTHORIZED_PARTIES=""

# Local development ONLY: skip Clerk and act as the tenant's first user, and
# resolve unknown hosts to the first tenant. Authentication is otherwise always
# enforced, whatever NODE_ENV is. The API exits at boot if this is "true" while
# NODE_ENV=production.
HELM_DEV_AUTH_BYPASS="false"

# Comma-separated browser origins allowed by CORS (e.g.
# "https://app.gethelm.com,https://admin.gethelm.com"). Empty = no cross-origin
# access (all origins are allowed only in dev with HELM_DEV_AUTH_BYPASS=true).
CORS_ORIGINS=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PLATFORM_ACCOUNT_ID=""
# Stripe Connect OAuth (onboarding): platform client id + the single registered
# redirect URI, e.g. https://app.gethelm.com/api/onboarding/stripe/callback
STRIPE_CLIENT_ID=""
STRIPE_CONNECT_REDIRECT_URI=""

# QuickBooks Online
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
# Single registered redirect URI, e.g. https://app.gethelm.com/api/qbo/callback
QBO_REDIRECT_URI=""
# Intuit webhook verifier token. The QBO webhook refuses all requests when unset.
QBO_WEBHOOK_VERIFIER_TOKEN=""

# Anthropic (Insurance AI)
ANTHROPIC_API_KEY=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Resend Email
RESEND_API_KEY=""

# Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Redis (Upstash)
REDIS_URL=""

# App
NODE_ENV="development"
API_PORT=3001
WEB_PORT=5173
APP_DOMAIN="gethelm.com"
APP_URL="http://localhost:5173"
