# ----------------------------------------------------------------------------
# Helm environment. Keep in sync with apps/api/src/lib/env.ts and
# docs/DEPLOYMENT.md §6.
#
# REQUIRED when NODE_ENV=production: DATABASE_URL, CLERK_SECRET_KEY,
# CLERK_PUBLISHABLE_KEY. The API exits at boot without them, or if
# HELM_DEV_AUTH_BYPASS is "true" in production. Integrations below are
# optional for boot; the features that need them refuse to run without them.
# ----------------------------------------------------------------------------

# App
NODE_ENV="development"
API_PORT=3001
WEB_PORT=5173
# Public URL of the web app: OAuth/Stripe return URLs and callback redirects.
APP_URL="http://localhost:5173"
# Base URL printed on slip QR codes (slips.ts). To be consolidated with APP_URL.
APP_BASE_URL="http://localhost:5173"

# Comma-separated browser origins allowed by CORS (e.g.
# "https://app.gethelm.com,https://admin.gethelm.com"). Empty = no cross-origin
# browser access. All origins are allowed only in dev with HELM_DEV_AUTH_BYPASS=true.
CORS_ORIGINS=""

# Local development ONLY. Skips Clerk (acts as the tenant's oldest active owner)
# and resolves unknown hosts to the first tenant. Without it authentication is
# always enforced, whatever NODE_ENV is. Must be unset/false in production.
HELM_DEV_AUTH_BYPASS="false"

# Database
DATABASE_URL="postgresql://helm:change-me@localhost:5432/helm?schema=public"

# docker-compose only (compose refuses to start without POSTGRES_PASSWORD)
POSTGRES_USER="helm"
POSTGRES_PASSWORD=""
POSTGRES_DB="helm"
REDIS_MAXMEMORY="512mb"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Clerk Auth
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Svix secret for POST /api/auth/webhook (refuses webhooks when unset)
CLERK_WEBHOOK_SECRET=""
# Optional comma-separated allow-list for Clerk's azp claim (your app origins)
CLERK_AUTHORIZED_PARTIES=""
# Web build arg
VITE_CLERK_PUBLISHABLE_KEY=""
VITE_API_URL=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Connect OAuth (onboarding): platform client id + the single registered
# redirect URI, e.g. https://app.gethelm.com/api/onboarding/stripe/callback
# (defaults to ${APP_URL}/api/onboarding/stripe/callback).
STRIPE_CLIENT_ID=""
STRIPE_CONNECT_REDIRECT_URI=""

# QuickBooks Online
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
# Single registered redirect URI, e.g. https://app.gethelm.com/api/qbo/callback
QBO_REDIRECT_URI=""
# "sandbox" or "production"
QBO_ENVIRONMENT="sandbox"
# Intuit webhook verifier token. POST /api/qbo/webhook refuses everything when unset.
QBO_WEBHOOK_VERIFIER_TOKEN=""

# Anthropic (Insurance AI)
ANTHROPIC_API_KEY=""

# Cloudflare R2 (S3-compatible). The code reads R2_ENDPOINT and R2_BUCKET.
R2_ENDPOINT=""   # https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="helm-files"
R2_PUBLIC_URL=""
R2_UPLOAD_URL=""

# Resend Email
RESEND_API_KEY=""

# Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_DEFAULT_NUMBER=""

# E-sign
ESIGN_PROVIDER=""
DOCUSIGN_API_KEY=""
DOCUSIGN_ACCOUNT_ID=""

# Public lead forms
RECAPTCHA_SECRET_KEY=""

# Observability
SENTRY_DSN=""

# Note: IMPERSONATION_SECRET is no longer read. POST /api/admin/tenants/:id/impersonate
# is disabled (501) until the audited Phase 1 design; the hard-coded fallback key is gone.
