# Database
DATABASE_URL="postgresql://user:password@host:5432/helm?schema=public"
NEON_API_KEY=""

# Clerk Auth
CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_CLIENT_ID=""
STRIPE_PLATFORM_ACCOUNT_ID=""
# Webhook signing secrets: two endpoints, two secrets.
# STRIPE_WEBHOOK_SECRET_PLATFORM signs events on Helm's own account
# (SaaS subscription billing). STRIPE_WEBHOOK_SECRET_CONNECT signs events
# on connected accounts (marina payments, disputes, capability updates).
STRIPE_WEBHOOK_SECRET_PLATFORM=""
STRIPE_WEBHOOK_SECRET_CONNECT=""
# Legacy single-secret var kept for backwards compat while migrating.
STRIPE_WEBHOOK_SECRET=""

# Base URL used for Stripe Checkout return_url and OAuth redirects.
APP_URL="http://localhost:5000"

# QuickBooks Online
QBO_CLIENT_ID=""
QBO_CLIENT_SECRET=""
QBO_REDIRECT_URI=""

# Anthropic (Insurance AI)
ANTHROPIC_API_KEY=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Resend Email
RESEND_API_KEY=""

# Twilio SMS
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Redis (Upstash)
REDIS_URL=""

# App
NODE_ENV="development"
API_PORT=3001
WEB_PORT=5173
APP_DOMAIN="gethelm.com"
