# Keep the build context small and free of host artefacts. Both Dockerfiles
# install from pnpm-lock.yaml inside the image, so nothing from the host's
# node_modules or build output may leak in.

# Dependencies / build output (host-built, wrong platform, or stale)
node_modules
**/node_modules
dist
**/dist
.turbo
**/.turbo
coverage
**/coverage
.nyc_output
**/*.tsbuildinfo
.prisma
**/.prisma

# VCS / tooling
.git
.gitignore
.github
.claude
.vscode
.idea
.replit
*.swp
*.swo

# Secrets: never bake env files into an image
.env
.env.*
!.env.example

# Docs and Docker files themselves
docs
*.md
Dockerfile*
docker-compose*
.dockerignore

# Logs / OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db
