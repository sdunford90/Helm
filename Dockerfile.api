# =============================================================================
# Dockerfile.api - Multi-stage build for the Helm API service
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1: Install dependencies
# ---------------------------------------------------------------------------
FROM node:20-alpine AS deps

WORKDIR /app

# Copy workspace root package files
COPY package.json package-lock.json turbo.json ./

# Copy all workspace package.json files to preserve workspace structure
COPY apps/api/package.json ./apps/api/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/database/package.json ./packages/database/
COPY packages/ui-kit/package.json ./packages/ui-kit/
COPY tools/package.json ./tools/

RUN npm ci --production=false

# ---------------------------------------------------------------------------
# Stage 2: Build the API
# ---------------------------------------------------------------------------
FROM node:20-alpine AS build

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=deps /app/packages/shared-types/node_modules ./packages/shared-types/node_modules 2>/dev/null || true
COPY --from=deps /app/packages/database/node_modules ./packages/database/node_modules 2>/dev/null || true

# Copy all source files
COPY package.json package-lock.json turbo.json tsconfig.json ./
COPY apps/api/ ./apps/api/
COPY packages/ ./packages/
COPY tools/ ./tools/

# Generate Prisma client
RUN npx prisma generate --schema=apps/api/prisma/schema.prisma

# Build using Turborepo (builds dependencies first via dependsOn)
RUN npx turbo build --filter=@helm/api

# ---------------------------------------------------------------------------
# Stage 3: Production runtime
# ---------------------------------------------------------------------------
FROM node:20-alpine AS runtime

WORKDIR /app

# Install security updates
RUN apk --no-cache upgrade

# Create non-root user
RUN addgroup --system helm && adduser --system --ingroup helm helm

# Copy built artifacts
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/prisma ./prisma
COPY --from=build /app/apps/api/package.json ./

# Copy node_modules (includes generated Prisma client)
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/node_modules ./apps_node_modules
# Merge workspace-level and app-level dependencies
RUN cp -rn ./apps_node_modules/* ./node_modules/ 2>/dev/null || true && rm -rf ./apps_node_modules

# Switch to non-root user
USER helm

EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3001/api/health || exit 1

CMD ["node", "dist/index.js"]
