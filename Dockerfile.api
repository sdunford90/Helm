# syntax=docker/dockerfile:1.7
# =============================================================================
# Dockerfile.api: Helm API + background worker (one image, two commands)
#
#   API:     docker run IMAGE                         (CMD node dist/index.js)
#   Worker:  docker run IMAGE node dist/worker.js
#   Migrate: docker run IMAGE node_modules/.bin/prisma migrate deploy
#   (all relative to WORKDIR /app/apps/api)
#
# Build from the repo root:  docker build -f Dockerfile.api -t helm-api .
# See docs/DEPLOYMENT.md for the reasoning behind each choice below.
# =============================================================================

# Debian slim rather than Alpine: Prisma's engines and (if ever needed)
# Chromium are first-class on glibc. Override NODE_IMAGE to use a mirror.
ARG NODE_IMAGE=node:22-bookworm-slim
ARG PNPM_VERSION=9.15.9

# -----------------------------------------------------------------------------
# base: node + pnpm + openssl (Prisma needs libssl at generate and run time)
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    # Chrome isn't installed. lib/pdf.ts (puppeteer) has no callers today.
    # See docs/DEPLOYMENT.md, "PDF generation".
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*
# Use npm, not corepack: corepack's signature checks have broken pnpm
# installs before, and it no longer ships with newer Node releases.
RUN npm install -g "pnpm@${PNPM_VERSION}" && pnpm --version
WORKDIR /repo

# -----------------------------------------------------------------------------
# fetch: download every package in the lockfile into the pnpm store.
# This layer only changes when pnpm-lock.yaml changes.
# -----------------------------------------------------------------------------
FROM base AS fetch
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

# -----------------------------------------------------------------------------
# build: offline install, prisma generate, compile only the API + its deps
# -----------------------------------------------------------------------------
FROM fetch AS build
COPY . .
RUN pnpm install --offline --frozen-lockfile --filter "@helm/api..."
RUN pnpm --filter @helm/api run generate
RUN pnpm --filter "@helm/api..." run build

# -----------------------------------------------------------------------------
# prod-deps: production-only node_modules for the API, installed from the
# lockfile (reproducible). We don't use `pnpm deploy`: in pnpm 9 it
# re-resolves versions without the lockfile and can't run offline.
# -----------------------------------------------------------------------------
FROM fetch AS prod-deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/api/package.json apps/api/
COPY apps/api/prisma apps/api/prisma
# `pnpm fetch` also fills node_modules/.pnpm with every workspace package.
# Remove it so only the API's production dependency closure is linked.
RUN rm -rf node_modules \
 && pnpm install --offline --frozen-lockfile --prod --filter @helm/api
# The generated client lives inside node_modules, so generate it here.
RUN pnpm --filter @helm/api exec prisma generate

# -----------------------------------------------------------------------------
# runtime
# -----------------------------------------------------------------------------
FROM ${NODE_IMAGE} AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 helm \
 && useradd --system --uid 10001 --gid helm --home-dir /app --shell /usr/sbin/nologin helm

ENV NODE_ENV=production \
    API_PORT=3001 \
    PUPPETEER_SKIP_DOWNLOAD=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=1

WORKDIR /app/apps/api
# Files stay root-owned, so the app user cannot modify its own code.
# The pnpm layout is kept: /app/node_modules/.pnpm is the virtual store, and
# /app/apps/api/node_modules holds relative symlinks into it.
COPY --from=prod-deps /repo/node_modules /app/node_modules
COPY --from=prod-deps /repo/apps/api /app/apps/api
COPY --from=build /repo/apps/api/dist /app/apps/api/dist

USER helm
EXPOSE 3001

# Liveness only. The worker and migrate commands disable this (see
# docker-compose.yml) because they don't serve HTTP.
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+(process.env.API_PORT||3001)+'/api/health').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]

# tini reaps zombies and forwards SIGTERM so the API and BullMQ workers
# can shut down gracefully.
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "dist/index.js"]
