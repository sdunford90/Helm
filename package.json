{
  "name": "helm",
  "private": true,
  "version": "1.0.0",
  "description": "Helm Marina Management Platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "cd apps/api && npx prisma generate",
    "db:migrate": "cd apps/api && npx prisma migrate deploy",
    "db:migrate:all": "ts-node tools/migrate-all.ts",
    "db:studio": "cd apps/api && npx prisma studio"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "ts-node": "^10.9.2",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
